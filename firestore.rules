rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserPrivateProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email == request.auth.token.email
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSolvedIds(listVal) {
      return listVal is list
        && listVal.size() <= 22
        && (listVal.size() == 0 || (listVal[0] is int && listVal[0] >= 1 && listVal[0] <= 22));
    }

    function isValidLeaderboardProfile(data) {
      return data.keys().hasAll([
          'uid',
          'handle',
          'displayName',
          'department',
          'isPublic',
          'solvedIds',
          'solvedCount',
          'totalSubmissions',
          'acceptedSubmissions',
          'totalAcceptedRuntimeMs',
          'score',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'handle',
          'displayName',
          'department',
          'isPublic',
          'solvedIds',
          'solvedCount',
          'totalSubmissions',
          'acceptedSubmissions',
          'totalAcceptedRuntimeMs',
          'score',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.handle is string
        && data.handle.size() >= 2
        && data.handle.size() <= 24
        && data.handle.matches('^[a-z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 32
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 32
        && data.isPublic is bool
        && data.isPublic == true
        && isValidSolvedIds(data.solvedIds)
        && data.solvedCount is int
        && data.solvedCount >= 0
        && data.solvedCount <= 22
        && data.solvedCount == data.solvedIds.size()
        && data.totalSubmissions is int
        && data.totalSubmissions >= 0
        && data.totalSubmissions <= 10000
        && data.acceptedSubmissions is int
        && data.acceptedSubmissions >= 0
        && data.acceptedSubmissions <= data.totalSubmissions
        && data.totalAcceptedRuntimeMs is int
        && data.totalAcceptedRuntimeMs >= 0
        && data.totalAcceptedRuntimeMs <= 100000000
        && data.score is int
        && data.score >= 0
        && data.score <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll([
          'uid',
          'problemId',
          'problemTitle',
          'verdict',
          'passedCount',
          'totalCount',
          'runtimeMs',
          'pointsAwarded',
          'code',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'problemId',
          'problemTitle',
          'verdict',
          'passedCount',
          'totalCount',
          'runtimeMs',
          'pointsAwarded',
          'code',
          'createdAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.problemId is int
        && data.problemId >= 1
        && data.problemId <= 22
        && data.problemTitle is string
        && data.problemTitle.size() >= 1
        && data.problemTitle.size() <= 120
        && data.verdict is string
        && data.verdict.size() >= 1
        && data.verdict.size() <= 32
        && data.verdict in ['Accepted', 'Wrong Answer', 'Runtime Error', 'Time Limit Exceeded']
        && data.passedCount is int
        && data.passedCount >= 0
        && data.passedCount <= 20
        && data.totalCount is int
        && data.totalCount >= 1
        && data.totalCount <= 20
        && data.passedCount <= data.totalCount
        && data.runtimeMs is int
        && data.runtimeMs >= 0
        && data.runtimeMs <= 60000
        && data.pointsAwarded is int
        && data.pointsAwarded >= 0
        && data.pointsAwarded <= 375
        && data.code is string
        && data.code.size() >= 1
        && data.code.size() <= 64000
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Action Guards for Leaderboard Updates
    // -------------------------------------------------------------------------
    function isProfileEditAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['handle', 'displayName', 'department', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    function isRecordSubmissionAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'solvedIds',
          'solvedCount',
          'totalSubmissions',
          'acceptedSubmissions',
          'totalAcceptedRuntimeMs',
          'score',
          'updatedAt'
        ])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().totalSubmissions == existing().totalSubmissions + 1
        && incoming().acceptedSubmissions >= existing().acceptedSubmissions
        && incoming().acceptedSubmissions <= existing().acceptedSubmissions + 1
        && incoming().solvedCount >= existing().solvedCount
        && incoming().solvedCount <= existing().solvedCount + 1
        && incoming().totalAcceptedRuntimeMs >= existing().totalAcceptedRuntimeMs
        && incoming().totalAcceptedRuntimeMs <= existing().totalAcceptedRuntimeMs + 60000
        && incoming().score >= existing().score
        && incoming().score <= existing().score + 375;
    }

    // -------------------------------------------------------------------------
    // Collection: /users/{userId} (Private PII-Isolated Account Record)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;

      // Subcollection: /users/{userId}/submissions/{submissionId}
      // Enforces Master Gate against parent /users/{userId}
      match /submissions/{submissionId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(submissionId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isSignedIn()
          && isOwner(userId)
          && existing().uid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(submissionId)
          && isOwner(userId)
          && isValidSubmission(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Collection: /leaderboard/{userId} (Public Non-PII Shared Standings)
    // -------------------------------------------------------------------------
    match /leaderboard/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (isOwner(userId) || existing().isPublic == true);

      allow list: if isSignedIn()
        && existing().isPublic == true;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardProfile(incoming())
        && incoming().solvedIds.size() == 0
        && incoming().solvedCount == 0
        && incoming().totalSubmissions == 0
        && incoming().acceptedSubmissions == 0
        && incoming().totalAcceptedRuntimeMs == 0
        && incoming().score == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardProfile(incoming())
        && (isProfileEditAction() || isRecordSubmissionAction());

      allow delete: if false;
    }
  }
}
